#!/usr/bin/env python3
"""quota-publish：把本机额度快照推到公开仓库 cangwu-ai/agent-quota 的 data 分支，供仪表盘读取。

  quota-publish                                 采集本机快照并推送（Mac 每 10 分钟自动运行）
  quota-set <claude|grok|antigravity> <已用%> [重置日期 YYYY-MM-DD] [今日 token 数]   更新手动额度

公开仓库任何人可读，所以只推数字：不含机器名、路径或账号。
"""
import base64
import json
import os
import shutil
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path
from quota_schema import public_snapshot, public_manual

REPO = "cangwu-ai/agent-quota"
BRANCH = "data"
HERE = Path(__file__).resolve().parent
GH = shutil.which("gh") or "/opt/homebrew/bin/gh"
MANUAL_POOLS = ("claude", "grok", "antigravity")


def gh(args, payload=None):
    p = subprocess.run([GH, "api", *args] + (["--input", "-"] if payload is not None else []),
                       input=json.dumps(payload) if payload is not None else None,
                       capture_output=True, text=True)
    return p.returncode, p.stdout, p.stderr


def read(path):
    code, out, _ = gh([f"repos/{REPO}/contents/{path}?ref={BRANCH}"])
    if code != 0:
        return None, None
    d = json.loads(out)
    return json.loads(base64.b64decode(d["content"])), d["sha"]


def write(path, obj, message, sha=None):
    body = {"message": message, "branch": BRANCH,
            "content": base64.b64encode((json.dumps(obj, ensure_ascii=False, indent=1) + "\n").encode()).decode()}
    if sha:
        body["sha"] = sha
    code, _, err = gh(["-X", "PUT", f"repos/{REPO}/contents/{path}"], body)
    if code != 0:
        sys.exit(f"推送 {path} 失败：{err.strip()[:300]}")


def publish():
    collect = HERE / "quota-collect"
    result = subprocess.run([sys.executable, str(collect)], capture_output=True, text=True, check=True)
    if result.stderr:
        sys.stderr.write(result.stderr)  # 采集失败的原因写进 publish.log
    snap = json.loads(result.stdout)
    machine = snap["machine"]
    public = public_snapshot(snap)
    _, sha = read(f"data/{machine}.json")
    write(f"data/{machine}.json", public, f"{machine} 快照", sha)
    print(f"已推送 data/{machine}.json")


def set_manual(argv):
    if len(argv) < 2 or argv[0] not in MANUAL_POOLS:
        sys.exit("用法：quota-set <claude|grok|antigravity> <已用%> [重置日期 YYYY-MM-DD] [今日 token 数]")
    try:
        pct = float(argv[1])
    except ValueError:
        sys.exit("已用百分比要是数字")
    if not 0 <= pct <= 100:
        sys.exit("已用百分比要在 0 到 100 之间")
    reset = argv[2] if len(argv) > 2 else None
    if reset:
        try:
            datetime.strptime(reset, "%Y-%m-%d")
        except ValueError:
            sys.exit("重置日期格式是 YYYY-MM-DD")
    tokens = None
    if len(argv) > 3:
        try:
            tokens = int(argv[3])
            if tokens < 0:
                raise ValueError
        except ValueError:
            sys.exit("token 数必须是非负整数")
    data, sha = read("data/manual.json")
    data = data or {}
    data[argv[0]] = {"used_percent": pct, "resets_on": reset or (data.get(argv[0]) or {}).get("resets_on"),
                     "updated_at": datetime.now(timezone.utc).isoformat(), "tokens": tokens}
    write("data/manual.json", public_manual(data), f"手动额度 {argv[0]} {pct:g}%", sha)
    print(f"已更新 {argv[0]}：{pct:g}%")


if __name__ == "__main__":
    if Path(sys.argv[0]).name == "quota-set" or (len(sys.argv) > 1 and sys.argv[1] == "set"):
        set_manual(sys.argv[2:] if len(sys.argv) > 1 and sys.argv[1] == "set" else sys.argv[1:])
    else:
        publish()
