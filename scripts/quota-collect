#!/usr/bin/env python3
"""quota-collect：从本机日志采集 Codex 与 Claude 的用量，写成一份快照。

  quota-collect                 打印快照（JSON）
  quota-collect --save          另存到 ai-studio/quota/<机器名>.json

Codex：读 $CODEX_HOME/sessions 里最新一条 rate_limits（周用量百分比、重置时间）。
Claude：汇总 Claude 配置目录 projects/ 下各会话的 token 用量（近 5 小时、今天、近 7 天按天）。
Antigravity：agy -p /usage 返回各模型组的周 / 5 小时剩余比例（本地命令，不耗 token）。
Claude 日志里没有「占 Max 额度百分比」，这一项只能在仪表盘上手动填。
"""
import json
import os
import sys
from datetime import datetime, timedelta, timezone
from pathlib import Path

HOME = Path.home()
CODEX_HOME = Path(os.environ.get("CODEX_HOME", HOME / ".codex"))
CLAUDE_HOME = Path(os.environ.get("CLAUDE_CONFIG_DIR", HOME / ".claude"))
STUDIO = Path(os.environ.get("STUDIO_ROOT", HOME / "quota"))
MACHINE = os.environ.get("QUOTA_MACHINE") or ("grok-cloud" if Path("/workspace").exists() else "mac")
TZ = timezone(timedelta(hours=8))  # 按北京时间分天


def lines(path):
    with open(path, encoding="utf-8", errors="replace") as f:
        for line in f:
            try:
                yield json.loads(line)
            except ValueError:
                continue


def iso(ts):
    return datetime.fromtimestamp(ts, timezone.utc).isoformat() if ts else None


def codex():
    files = sorted((CODEX_HOME / "sessions").glob("*/*/*/*.jsonl"), key=lambda p: p.stat().st_mtime, reverse=True)
    for path in files[:20]:
        latest = None
        for d in lines(path):
            payload = d.get("payload") if isinstance(d.get("payload"), dict) else d
            rl = payload.get("rate_limits") if isinstance(payload, dict) else None
            if isinstance(rl, dict) and rl.get("primary"):
                latest = (d.get("timestamp"), rl)
        if latest:
            ts, rl = latest
            windows = []
            for key in ("primary", "secondary"):
                w = rl.get(key)
                if isinstance(w, dict) and w.get("used_percent") is not None:
                    windows.append({
                        "used_percent": w.get("used_percent"),
                        "window_minutes": w.get("window_minutes"),
                        "resets_at": iso(w.get("resets_at")),
                    })
            return {"observed_at": ts, "windows": windows, "plan_type": rl.get("plan_type"), **codex_tokens(files)}
    return None


def codex_tokens(files):
    """按天汇总 Codex token：每个会话的 total_token_usage 是累计值，取相邻两次的差。"""
    now = datetime.now(timezone.utc)
    since = now - timedelta(days=7)
    days = {(now.astimezone(TZ) - timedelta(days=i)).strftime("%Y-%m-%d"): [0, 0] for i in range(7)}
    last5h = 0
    for path in files:
        if datetime.fromtimestamp(path.stat().st_mtime, timezone.utc) < since:
            continue
        prev_total = prev_out = 0
        for d in lines(path):
            p = d.get("payload")
            if not isinstance(p, dict) or p.get("type") != "token_count" or not d.get("timestamp"):
                continue
            usage = (p.get("info") or {}).get("total_token_usage") or {}
            total, out = usage.get("total_tokens") or 0, usage.get("output_tokens") or 0
            delta, delta_out = max(0, total - prev_total), max(0, out - prev_out)
            prev_total, prev_out = max(prev_total, total), max(prev_out, out)
            t = datetime.fromisoformat(d["timestamp"].replace("Z", "+00:00"))
            if t < since:
                continue
            day = t.astimezone(TZ).strftime("%Y-%m-%d")
            if day in days:
                days[day][0] += delta
                days[day][1] += delta_out
            if t >= now - timedelta(hours=5):
                last5h += delta
    today = now.astimezone(TZ).strftime("%Y-%m-%d")
    return {
        "tokens_last_5h": last5h,
        "tokens_today": days[today][0],
        "output_tokens_today": days[today][1],
        "tokens_by_day": [{"day": k, "tokens": v[0], "output_tokens": v[1]} for k, v in sorted(days.items())],
    }


def antigravity():
    """agy -p /usage：本地命令，不调用模型、不耗 token。返回各模型组的周 / 5 小时已用百分比。"""
    import shutil
    import subprocess
    import tempfile
    # 找不到登录状态时 agy 会打开浏览器授权页。所以：
    # 1. 默认不调用，只有设置 QUOTA_AGY=1 时才读取（Mac 后台任务不设，云电脑设）；
    # 2. 调用时禁止打开浏览器；
    # 3. 一旦发现没登录，写下标记文件，之后不再尝试，直到删掉标记。
    if os.environ.get("QUOTA_AGY") != "1":
        return None
    state = Path("/workspace/.agents") if Path("/workspace/.agents").exists() else HOME
    marker = state / ".agy-auth-failed"
    if marker.exists():
        return None
    agy = shutil.which("agy") or str(HOME / ".local/bin/agy")
    if not Path(agy).exists():
        return None
    env = {**os.environ, "BROWSER": "true", "NO_BROWSER": "1"}
    try:
        with tempfile.TemporaryDirectory() as tmp:
            p = subprocess.run([agy, "-p", "/usage", "--output-format", "json"], cwd=tmp, env=env,
                               stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=90)
        if "Authentication required" in p.stdout + p.stderr:
            marker.write_text(f"{datetime.now(timezone.utc).isoformat()} agy 未登录。登录后删除此文件即可恢复采集。\n")
            print(f"antigravity 未登录，已停止采集（删除 {marker} 可恢复）", file=sys.stderr)
            return None
        groups = json.loads(p.stdout)["command"]["data"]["groups"]
    except (OSError, ValueError, KeyError, TypeError, subprocess.TimeoutExpired) as e:
        detail = locals().get("p")
        print(f"antigravity 采集失败：{type(e).__name__}；agy 输出：{(detail.stdout or detail.stderr)[:160] if detail else ''}",
              file=sys.stderr)
        return None
    out = []
    for g in groups:
        for b in g.get("buckets", []):
            if b.get("remaining_fraction") is None:
                continue
            out.append({"group": g.get("name"), "window": b.get("window"),
                        "used_percent": round((1 - b["remaining_fraction"]) * 100, 1),
                        "resets_at": b.get("reset_time")})
    return {"observed_at": datetime.now(timezone.utc).isoformat(), "buckets": out} if out else None


def claude():
    now = datetime.now(timezone.utc)
    since = now - timedelta(days=7)
    days = {(now.astimezone(TZ) - timedelta(days=i)).strftime("%Y-%m-%d"): [0, 0] for i in range(7)}
    last5h = 0
    output_7d = 0
    seen = set()
    newest = None
    for path in (CLAUDE_HOME / "projects").glob("*/*.jsonl"):
        if datetime.fromtimestamp(path.stat().st_mtime, timezone.utc) < since:
            continue
        for d in lines(path):
            msg = d.get("message")
            if not isinstance(msg, dict) or not isinstance(msg.get("usage"), dict) or not d.get("timestamp"):
                continue
            key = (msg.get("id"), d.get("requestId"))
            if key in seen:  # 同一条回复会按内容块重复记录
                continue
            seen.add(key)
            t = datetime.fromisoformat(d["timestamp"].replace("Z", "+00:00"))
            if t < since:
                continue
            u = msg["usage"]
            total = sum(u.get(k) or 0 for k in ("input_tokens", "output_tokens",
                                                "cache_creation_input_tokens", "cache_read_input_tokens"))
            day = t.astimezone(TZ).strftime("%Y-%m-%d")
            if day in days:
                days[day][0] += total
                days[day][1] += u.get("output_tokens") or 0
            output_7d += u.get("output_tokens") or 0
            if t >= now - timedelta(hours=5):
                last5h += total
            newest = max(newest or t, t)
    if newest is None:
        return None
    today = now.astimezone(TZ).strftime("%Y-%m-%d")
    return {
        "observed_at": newest.isoformat(),
        "tokens_last_5h": last5h,
        "tokens_today": days.get(today, [0, 0])[0],
        "output_tokens_today": days.get(today, [0, 0])[1],
        "output_tokens_7d": output_7d,
        "tokens_by_day": [{"day": k, "tokens": v[0], "output_tokens": v[1]} for k, v in sorted(days.items())],
    }


def main():
    snap = {
        "machine": MACHINE,
        "collected_at": datetime.now(timezone.utc).isoformat(),
        "updated_at": datetime.now(timezone.utc).isoformat(),
        "codex": codex(),
        "claude": claude(),
        "antigravity": antigravity(),
    }
    text = json.dumps(snap, ensure_ascii=False, indent=1)
    if "--save" in sys.argv:
        out = STUDIO / "quota" / f"{MACHINE}.json"
        out.parent.mkdir(parents=True, exist_ok=True)
        if out.exists():  # 只有采集时间变了就不重写，避免每次都产生提交
            old = json.loads(out.read_text(encoding="utf-8"))
            if {k: v for k, v in old.items() if k not in ("collected_at", "updated_at")} == {k: v for k, v in snap.items() if k not in ("collected_at", "updated_at")}:
                print(f"无变化 {out}")
                return
        out.write_text(text + "\n", encoding="utf-8")
        print(f"已保存 {out}")
    else:
        print(text)


if __name__ == "__main__":
    main()
